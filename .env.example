# Token del bot (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=tu_token_aqui

# Client ID de la aplicación (Developer Portal > General Information > Application ID)
CLIENT_ID=tu_client_id_aqui

# (Opcional) ID de un servidor concreto para desplegar los comandos al instante
# Si lo dejas vacío, los comandos se registran de forma global (tardan hasta 1h en aparecer)
GUILD_ID=

# API key de Groq (console.groq.com) para las respuestas de IA al mencionar al bot
GROQ_API_KEY=

# Enlace a tu cuenta/canal de TikTok, usado por /desktop tiktok
TIKTOK_URL=

# Enlace a tu canal de Twitch, usado por /desktop twitch
TWITCH_URL=

# ID del canal donde se enviarán las sugerencias de /sugerir
SUGGESTIONS_CHANNEL_ID=

# (Opcional) ID de la categoría de Discord donde se crearán los canales de ticket
TICKET_CATEGORY_ID=
